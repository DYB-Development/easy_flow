<% content_for(:title, "Complete") %>

<% starting_over = flow_start_path(@guide.slug) %>

<%= ui_page(max_width: :md) do %>
  <%= ui_page_header(title: "That's everything", subtitle: "Thanks — here's what you told us") do |header| %>
    <% header.action do %>
      <%= ui_button(label: "Start over", href: starting_over, variant: :secondary) %>
    <% end %>
  <% end %>

  <%= ui_section do %>
    <ul class="divide-y border-y divide-[var(--ks-color-divider)] border-[var(--ks-color-divider)] dark:divide-[var(--ks-color-divider-dark)] dark:border-[var(--ks-color-divider-dark)]">
      <% @answered.each do |step, value| %>
        <li data-answer="<%= step %>" class="flex items-baseline justify-between gap-6 py-3">
          <span class="text-[var(--ks-color-text-muted)] dark:text-[var(--ks-color-text-muted-dark)]"><%= @guide.question_text(step) %></span>
          <span class="shrink-0 font-medium text-[var(--ks-color-text)] dark:text-[var(--ks-color-text-dark)]"><%= @guide.choice_label(step, value) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
