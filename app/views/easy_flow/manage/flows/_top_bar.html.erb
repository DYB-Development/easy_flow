<% muted = "text-[var(--ks-color-text-muted)] dark:text-[var(--ks-color-text-muted-dark)]" %>
<% segment = "px-3 py-1.5" %>
<header class="flex shrink-0 flex-wrap items-center gap-x-3 gap-y-2 border-b border-[var(--ks-color-divider)] dark:border-[var(--ks-color-divider-dark)] px-5 py-2.5" data-top-bar>
  <% if back_link %>
    <%= link_to back_link.label, back_link.address, class: "text-sm #{muted} before:content-['←_']" %>
  <% else %>
    <%= link_to "All flows", flow_routes.manage_flows_path, class: "text-sm #{muted} before:content-['←_']" %>
  <% end %>
  <% if parent %>
    <%= link_to "Back to #{parent.title.presence || parent.slug}", flow_routes.manage_flow_path(parent), class: "text-sm #{muted} before:content-['←_']" %>
  <% end %>

  <h1 class="text-base font-semibold text-[var(--ks-color-text)] dark:text-[var(--ks-color-text-dark)]" data-flow-heading><%= flow.title.presence || flow.slug %></h1>
  <span class="font-mono text-xs <%= muted %>" data-version-status><%= EasyFlow::DraftStatus.new(flow) %></span>

  <nav class="flex overflow-hidden rounded-md border border-[var(--ks-color-border-control)] dark:border-[var(--ks-color-border-control-dark)] ml-3 text-xs" data-view-switch>
    <% { "Canvas" => [ :canvas, flow_routes.manage_flow_path(flow) ], "Text" => [ :text, flow_routes.edit_manage_flow_definition_path(flow) ] }.each do |label, (view, address)| %>
      <% if view == showing %>
        <span class="<%= segment %> bg-accent-600 text-white" aria-current="page"><%= label %></span>
      <% else %>
        <%= link_to label, address, class: "#{segment} text-[var(--ks-color-text)] dark:text-[var(--ks-color-text-dark)]" %>
      <% end %>
    <% end %>
  </nav>

  <% actions = [] %>
  <% actions << { label: "This flow", data: { bar_action: "open", open_panel: true } } if showing == :canvas %>
  <% actions << { label: "Try it", href: flow_routes.manage_flow_preview_path(flow) } %>
  <% flow_host.editor_buttons_for(flow).each { |button| actions << { label: button.label, href: button.address } } %>
  <% if showing == :canvas %>
    <% actions << { label: "Save draft", data: { bar_action: "save_draft" } } %>
    <% actions << { label: "Publish v#{EasyFlow::DraftStatus.new(flow).publishes}", data: { bar_action: "publish" }, primary: true } %>
  <% end %>

  <div class="ml-auto hidden flex-wrap items-center gap-2 sm:flex">
    <% actions.each do |action| %>
      <%= ui_button(label: action[:label], href: action[:href], type: :button, variant: action[:primary] ? :primary : :secondary, size: :sm, data: action[:data]) %>
    <% end %>
  </div>

  <details class="relative ml-auto sm:hidden" data-bar-menu>
    <summary class="ks-button ks-button-secondary ks-button-sm cursor-pointer list-none" aria-label="Actions">⋯</summary>
    <div class="ks-action-menu absolute right-0 z-50 w-48">
      <% actions.each do |action| %>
        <% if action[:href] %>
          <%= link_to action[:label], action[:href], class: "ks-menu-option block w-full text-left text-sm" %>
        <% else %>
          <%= tag.button action[:label], type: "button", class: "ks-menu-option block w-full text-left text-sm", data: action[:data] %>
        <% end %>
      <% end %>
    </div>
  </details>
</header>
