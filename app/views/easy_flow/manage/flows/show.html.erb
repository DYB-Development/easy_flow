<% content_for :head do %>
  <%= javascript_include_tag "keystone_ui/react", defer: true %>
  <%= javascript_include_tag "easy_flow/canvas", defer: true %>
<% end %>

<div class="flex h-screen flex-col overflow-hidden">
  <%= render "easy_flow/manage/flows/top_bar", flow: @flow, showing: :canvas, parent: @parent, back_link: @back_link %>

  <%= react_ui("easy_flow/flow-editor", { base: flow_routes.manage_flow_canvas_path(@flow), token: form_authenticity_token, initial: @canvas },
               class: "min-h-0 flex-1",
               data: { flow_canvas: true }) %>
</div>
