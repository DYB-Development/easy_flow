<%= ui_page(max_width: :lg) do %>
  <p class="mb-4">
    <%= link_to "← Back to the flow", flow_routes.manage_flow_path(@flow), class: "text-sm text-accent-600 hover:text-accent-700" %>
  </p>

  <%= ui_page_header(title: "History", subtitle: @flow.title.presence || @flow.slug) %>

  <%= ui_section do %>
    <ul class="divide-y border-y divide-[var(--ks-color-divider)] border-[var(--ks-color-divider)] dark:divide-[var(--ks-color-divider-dark)] dark:border-[var(--ks-color-divider-dark)]">
      <% @versions.each do |version| %>
        <li data-version="<%= version.number %>" class="py-4">
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-medium text-[var(--ks-color-text)] dark:text-[var(--ks-color-text-dark)]">Version <%= version.number %></span>
            <span class="text-sm text-[var(--ks-color-text-muted)] dark:text-[var(--ks-color-text-muted-dark)]"><%= version.created_at.to_fs(:long) %></span>
          </div>

          <% if version == @flow.live_version %>
            <p data-live class="mt-1 text-sm font-medium text-green-700">Visitors run this version</p>
          <% end %>

          <% if version.changes.any? %>
            <ul class="mt-2 space-y-0.5">
              <% version.changes.each do |change| %>
                <li data-captured class="text-sm text-[var(--ks-color-text-muted)] dark:text-[var(--ks-color-text-muted-dark)]"><%= EasyFlow::Change.phrase(change) %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-2 text-sm text-[var(--ks-color-text-muted)] dark:text-[var(--ks-color-text-muted-dark)]">Nothing was recorded against this version.</p>
          <% end %>

          <% unless version == @versions.first %>
            <%= button_to "Return the flow to this version",
                  flow_routes.return_manage_flow_version_path(@flow, version),
                  form: { data: { turbo: false } }, data: { return: true },
                  class: "ks-button ks-button-secondary ks-button-sm mt-3" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
