<fieldset>
  <%= render "easy_flow/steps/picture", step: step %>
  <legend class="ks-section-title mb-5 text-xl font-semibold leading-snug"><%= step.text %></legend>

  <div class="space-y-3">
    <% step.choices.each do |choice| %>
      <%= ui_radio_card(name: "answers[#{step.id}]", value: choice.value, label: choice.label.presence || choice.value, hint: choice.hint, info: choice.info, checked: choice.value == local_assigns[:chosen]) %>
    <% end %>
  </div>
</fieldset>
