<fieldset>
  <%= render "easy_flow/steps/picture", step: step %>
  <legend class="ks-section-title mb-5 text-xl font-semibold leading-snug"><%= step.text %></legend>

  <%= hidden_field_tag "answers[#{step.id}][]", "", id: nil %>
  <div class="space-y-3">
    <% step.choices.each do |choice| %>
      <%= ui_checkbox_row(name: "answers[#{step.id}][]", value: choice.value, label: choice.label.presence || choice.value, info: choice.info, checked: Array(local_assigns[:chosen]).include?(choice.value)) %>
    <% end %>
  </div>
</fieldset>
